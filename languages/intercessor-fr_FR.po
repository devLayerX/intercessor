#: src/Admin/DisplayPage.php:142
msgid "Auto-Approve Requests"
msgstr "Demandes à approbation automatique"

#: src/Admin/DisplayPage.php:143
msgid ""
"Automatically approve all incoming prayer requests without manual review."
msgstr ""
"Approbation automatique de toutes les demandes de prière entrantes sans "
"examen manuel."

#: src/Admin/DisplayPage.php:149
msgid "Require Login to Submit"
msgstr "Connexion requise pour soumettre"

#: src/Admin/DisplayPage.php:150
msgid "Only logged-in users may submit prayer requests."
msgstr ""
"Seuls les utilisateurs connectés peuvent soumettre des demandes de prière."

#: src/Admin/DisplayPage.php:156
msgid "Allow Anonymous Requests"
msgstr "Autoriser les requêtes anonymes"

#: src/Admin/DisplayPage.php:157
msgid "Allow submitters to hide their identity on public-facing displays."
msgstr ""
"Autoriser les personnes qui soumettent des documents à masquer leur identité "
"sur les écrans publics."

#: src/Admin/DisplayPage.php:163
msgid "Max Requests Per Email / Day"
msgstr "Nombre maximal de requêtes par courriel et par jour"

#: src/Admin/DisplayPage.php:164
msgid ""
"Maximum prayer requests one email address may submit in a 24-hour window. "
"Set to 0 to disable rate limiting."
msgstr ""
"Nombre maximal de demandes de prière qu'une adresse e-mail peut soumettre "
"sur une période de 24 heures. Indiquez 0 pour désactiver cette limitation."

#: src/Admin/DisplayPage.php:176
msgid "Moderation Options"
msgstr "Options de modération"

#: src/Admin/DisplayPage.php:180
msgid "Enable Profanity Filter"
msgstr "Activer le filtre anti-gros mots"

#: src/Admin/DisplayPage.php:181
msgid "Flag requests containing prohibited words for manual review."
msgstr ""
"Signalez les demandes contenant des mots interdits pour une vérification "
"manuelle."

#: src/Admin/DisplayPage.php:187
msgid "Prohibited Words"
msgstr "Mots interdits"

#: src/Admin/DisplayPage.php:188
msgid "Comma-separated list of words that trigger moderation."
msgstr "Liste de mots séparés par des virgules qui déclenchent une modération."

#: src/Admin/DisplayPage.php:194
msgid "Moderator Role"
msgstr "Rôle de modérateur"

#: src/Admin/DisplayPage.php:195
msgid "Minimum WordPress role required to approve/reject requests."
msgstr "Rôle WordPress minimum requis pour approuver/rejeter les demandes."

#: src/Admin/DisplayPage.php:199
msgid "Editor"
msgstr "Éditeur"

#: src/Admin/DisplayPage.php:200
msgid "Administrator only"
msgstr "Administrateur uniquement"

#: src/Admin/DisplayPage.php:210
msgid "Email Notifications"
msgstr "Notifications par e-mail"

#: src/Admin/DisplayPage.php:214
msgid "Notify Admin on New Request"
msgstr "Notifier l'administrateur en cas de nouvelle demande"

#: src/Admin/DisplayPage.php:215
msgid "Send an email to the admin when a new prayer request is submitted."
msgstr ""
"Envoyez un courriel à l'administrateur lorsqu'une nouvelle demande de prière "
"est soumise."

#: src/Admin/DisplayPage.php:221
msgid "Notify Requester on Receipt"
msgstr "Aviser le demandeur à réception"

#: src/Admin/DisplayPage.php:222
msgid "Send a confirmation email to the requester after submission."
msgstr "Envoyer un courriel de confirmation au demandeur après la soumission."

#: src/Admin/DisplayPage.php:228
msgid "Notify Requester on Status Change"
msgstr "Notifier le demandeur en cas de changement de statut"

#: src/Admin/DisplayPage.php:229
msgid "Email the requester when their request is approved or rejected."
msgstr ""
"Envoyer un courriel au demandeur lorsque sa demande est approuvée ou rejetée."

#: src/Admin/DisplayPage.php:235
msgid "Admin Notification Email"
msgstr "Courriel de notification de l'administrateur"

#: src/Admin/DisplayPage.php:236
msgid "Defaults to the site admin email if left blank."
msgstr ""
"Par défaut, l'adresse e-mail de l'administrateur du site sera utilisée si ce "
"champ est laissé vide."

#: src/Admin/DisplayPage.php:242
msgid "From Name"
msgstr "Nom de départ"

#: src/Admin/DisplayPage.php:248
msgid "From Email Address"
msgstr "Adresse e-mail de l'expéditeur"

#: src/Admin/DisplayPage.php:259
msgid "Block & Shortcode Display"
msgstr "Affichage des blocs et des codes courts"

#: src/Admin/DisplayPage.php:263
msgid "Requests Per Page"
msgstr "Requêtes par page"

#: src/Admin/DisplayPage.php:264
msgid "Default number of prayer requests shown in the Prayer List block."
msgstr ""
"Nombre par défaut de demandes de prière affichées dans le bloc Liste de "
"prières."

#: src/Admin/DisplayPage.php:272
msgid "Show Submission Date"
msgstr "Afficher la date de soumission"

#: src/Admin/DisplayPage.php:278
msgid "Show Requester Name"
msgstr "Afficher le nom du demandeur"

#: src/Admin/DisplayPage.php:284
msgid "Date Format"
msgstr "Format de date"

#: src/Admin/DisplayPage.php:285
msgid "PHP date format string. Leave blank to use the WordPress site default."
msgstr ""
"Format de date PHP. Laisser vide pour utiliser le format par défaut du site "
"WordPress."

#: src/Admin/DisplayPage.php:296
msgid "API Keys"
msgstr "Clés API"

#: src/Admin/DisplayPage.php:300
msgid "Site Key (public)"
msgstr "Clé du site (publique)"

#: src/Admin/DisplayPage.php:301
msgid ""
"Obtain your keys from google.com/recaptcha/admin. Use the key that appears "
"in HTML."
msgstr ""
"Obtenez vos clés sur google.com/recaptcha/admin. Utilisez la clé qui "
"apparaît dans le code HTML."

#: src/Admin/DisplayPage.php:307
msgid "Secret Key (private)"
msgstr "Clé secrète (privée)"

#: src/Admin/DisplayPage.php:308
msgid "Used for server-side verification. Never share or expose this key."
msgstr ""
"Utilisée pour la vérification côté serveur. Ne jamais partager ni divulguer "
"cette clé."

#: src/Admin/DisplayPage.php:315
msgid "Configuration"
msgstr "Configuration"

#: src/Admin/DisplayPage.php:319
msgid "reCAPTCHA Version"
msgstr "Version reCAPTCHA"

#: src/Admin/DisplayPage.php:320
msgid ""
"v2 shows a checkbox widget. v3 is invisible and uses a score (0.0–1.0) to "
"determine if the user is human."
msgstr ""
"La version 2 affiche un widget de case à cocher. La version 3 est invisible "
"et utilise un score (0,0–1,0) pour déterminer si l'utilisateur est humain."

#: src/Admin/DisplayPage.php:325
msgid "v3 — Invisible (score-based)"
msgstr "v3 — Invisible (basé sur le score)"

#: src/Admin/DisplayPage.php:330
msgid "v3 Score Threshold"
msgstr "Seuil de score v3"

#: src/Admin/DisplayPage.php:340
msgid "Enable on Pages"
msgstr "Activer sur les pages"

#: src/Admin/DisplayPage.php:344
msgid "Prayer Request Form"
msgstr "Formulaire de demande de prière"

#: src/Admin/DisplayPage.php:345
msgid ""
"Show reCAPTCHA on the Prayer Form block to protect against automated "
"submissions."
msgstr ""
"Afficher reCAPTCHA sur le bloc Formulaire de prière pour se protéger contre "
"les soumissions automatisées."

#: src/Admin/DisplayPage.php:351
msgid "Prayer History Page"
msgstr "Page d'histoire de la prière"

#: src/Admin/DisplayPage.php:352
msgid "Load the reCAPTCHA script on pages containing the Prayer History block."
msgstr ""
"Chargez le script reCAPTCHA sur les pages contenant le bloc Historique des "
"prières."

#: src/Admin/DisplayPage.php:363
msgid "Export Options"
msgstr "Options d'exportation"

#: src/Admin/DisplayPage.php:367
msgid "Include Prayer Content in Requests Export"
msgstr "Inclure le contenu des prières dans l'exportation des demandes"

#: src/Admin/DisplayPage.php:368
msgid ""
"When checked, the full prayer request body is included in the Prayer "
"Requests CSV."
msgstr ""
"Une fois vérifiée, la totalité du texte de la demande de prière est incluse "
"dans le fichier CSV des demandes de prière."

#: src/Admin/DisplayPage.php:374
msgid "Filter Requests Export by Status"
msgstr "Filtrer les demandes d'exportation par statut"

#: src/Admin/DisplayPage.php:375
msgid "Leave as \"All\" to export all prayer requests regardless of status."
msgstr ""
"Laissez l'option « Tout » pour exporter toutes les demandes de prière, quel "
"que soit leur statut."

#: src/Admin/DisplayPage.php:379
msgid "All Statuses"
msgstr "Tous les statuts"

#: src/Admin/DisplayPage.php:380
msgid "Pending only"
msgstr "En attente seulement"

#: src/Admin/DisplayPage.php:381
msgid "Approved only"
msgstr "Approuvé uniquement"

#: src/Admin/DisplayPage.php:382
msgid "Rejected only"
msgstr "Rejeté uniquement"

#: src/Admin/DisplayPage.php:383
msgid "Archived only"
msgstr "Archivé uniquement"

#: src/Admin/DisplayPage.php:388
msgid "Prayed Counts Export Mode"
msgstr "Mode d'exportation des décomptes de prières"

#: src/Admin/DisplayPage.php:389
msgid ""
"Aggregated: one row per request with total count. Detailed: one row per "
"actor interaction."
msgstr ""
"Données agrégées : une ligne par requête avec le nombre total. Données "
"détaillées : une ligne par interaction d’acteur."

#: src/Admin/DisplayPage.php:393
msgid "Aggregated (totals per request)"
msgstr "Total agrégé (totaux par requête)"

#: src/Admin/DisplayPage.php:394
msgid "Detailed (per actor)"
msgstr "Détaillé (par acteur)"

#: src/Admin/DisplayPage.php:404
msgid "Data Management"
msgstr "Gestion des données"

#: src/Admin/DisplayPage.php:408
msgid "Delete All Data on Uninstall"
msgstr "Supprimer toutes les données lors de la désinstallation"

#: src/Admin/DisplayPage.php:409
msgid ""
"WARNING: When checked, all prayer requests, requesters, prayed counts, and "
"settings will be permanently deleted when the plugin is removed."
msgstr ""
"ATTENTION : Si cette option est activée, toutes les demandes de prière, les "
"demandeurs, le nombre de prières effectuées et les paramètres seront "
"définitivement supprimés lors de la désinstallation du plugin."

