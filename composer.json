{
    "name": "victoraigbeghian/intercessor",
    "description": "Manage prayer requests submitted by site visitors — WordPress plugin.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Victor Aigbeghian",
            "homepage": "https://github.com/victoraigbeghian"
        }
    ],
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcsstandards/phpcsutils": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Intercessor\\": "src/"
        },
        "exclude-from-classmap": [
            "src/includes/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Intercessor\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "test": "phpunit --testsuite unit",
        "phpcs": "phpcs --standard=WordPress src/",
        "phpcbf": "phpcbf --standard=WordPress src/"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
